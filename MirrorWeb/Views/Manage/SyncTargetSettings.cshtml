@model MirrorWeb.ViewModels.Manage.SyncTargetViewModel

<br />
<div class="col-xl-12 mb-5 mb-xl-0">
    <div class="card ktb-var-normal-gradient shadow">

        <div class="card-body">
            <div id="kafkaSettings" align="center" style="text-align: center">

                <div class="card shadow">
                    <div class="card-header bg-transparent custHeaderBackground">
                        <div class="row">
                            <div class="col">
                                <h5 class="mb-0 custHeaderColor">Synchronization Target Settings</h5>
                            </div>
                        </div>
                    </div>

                    <div class="card-body" style="margin-top: 40px; margin-bottom: 40px;">
                        <div>

                            <div id="kafkaSection" style="width: 100%;">


                                <div class="btn-toolbar" role="toolbar" style="display:inline-block">
                                    <div class="btn-group mr-2" role="group">
                                        @Html.DropDownListFor(m => m.Targetname, Model.SyncTargets, "--- Select Synchronization Target ---", new { @id = "SyncTargetSettings", @class = "form-control", @onchange = "SetSyncTargetValues()", @style = "font-size:12px; text-align: center;" })
                                    </div>

                                    <div class="btn-group mr-2" role="group">
                                        <a href="#" onclick="ResetSyncTargetFields()"><i class="fa fa-plus" style="font-size:12px"></i></a>
                                    </div>

                                </div>

                                <br />
                                <br />

                                <div id="snowSyncTargetSection" style="text-align: center; margin: auto; width: 390px;">

                                    <!-- Id -->
                                    <div class="input-group mb-3">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" id="inputGroup-sizing-default" style="width: 115px; font-size:12px;">TargetId</span>
                                        </div>
                                        @Html.TextBoxFor(m => m.Id, new { @name = "syncTargetId", @id = "syncTargetId", @class = "form-control", @readonly = true, @style = "font-size:12px;" })
                                    </div>

                                    <!-- TargetType -->
                                    <div class="input-group mb-3">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" id="inputGroup-sizing-default" style="width: 115px; font-size: 12px;">Target</span>
                                        </div>
                                        @Html.DropDownListFor(d => d.SelectedSyncTargetType, new SelectList(Model.SyncTargetTypes, "Value", "Text", 0), new { @class = "k-content", @id = "syncTargetType", @style = "font-size: 12px; width: 275px; text-align: center;" })
                                        
                                    </div>
                                    
                                    <!-- Targetname -->
                                    <div class="input-group mb-3">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" id="inputGroup-sizing-default" style="width: 115px; font-size:12px;">Targetname</span>
                                        </div>
                                        @Html.TextBoxFor(m => m.Targetname, new { @name = "syncTargetname", @id = "syncTargetname", @class = "form-control", @style = "font-size:12px;" })
                                    </div>

                                    <!-- Endpoint -->
                                    <div class="input-group mb-3">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" id="inputGroup-sizing-default" style="width: 115px; font-size:12px;">Endpoint</span>
                                        </div>
                                        @Html.TextBoxFor(m => m.Endpoint, new { @name = "syncTargetEndpoint", @id = "syncTargetEndpoint", @class = "form-control", @style = "font-size:12px;" })
                                    </div>

                                    <!-- Username -->
                                    <div class="input-group mb-3">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" id="inputGroup-sizing-default" style="width: 115px; font-size:12px;">Username</span>
                                        </div>
                                        @Html.TextBoxFor(m => m.Username, new { @name = "syncTargetUsername", @id = "syncTargetUsername", @class = "form-control", @style = "font-size:12px;" })
                                    </div>

                                    <!-- Password -->
                                    <div class="input-group mb-3">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" id="inputGroup-sizing-default" style="width: 115px; font-size:12px;">Password</span>
                                        </div>
                                        @Html.TextBoxFor(m => m.Password, new { @name = "syncTargetPassword", @id = "syncTargetPassword", @class = "form-control", @style = "font-size:12px;" })
                                    </div>
                                </div>


                                <div id="updateSyncTargetRow" style="width: 100%; margin-top: 20px">
                                    <div class="col text-center">
                                        <button type="submit" class="btn custHeaderBackground" id="updateSyncTarget" style="font-size: 12px; color: white">Update</button>
                                    </div>
                                </div>

                                <div id="saveNewSyncTargetRow" style="width: 100%; margin-top: 20px">
                                    <div class="col text-center">
                                        <button type="submit" class="btn custHeaderBackground" id="saveNewSyncTarget" style="font-size: 12px; color: white">Save</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/kendo")
    @Scripts.Render("~/bundles/syncAdminSettings")
}