@model MirrorWeb.ViewModels.DatabaseSettingsViewModel

<br />
<div class="col-xl-12 mb-5 mb-xl-0">
    <div class="card ktb-var-normal-gradient shadow">

        <div class="card-body">
            <div id="databaseSettings" align="center" style="text-align: center">

                <div class="card shadow">
                    <div class="card-header bg-transparent custHeaderBackground">
                        <div class="row">
                            <div class="col">
                                <h5 class="mb-0 custHeaderColor">Database Settings</h5>
                            </div>
                        </div>
                    </div>
                    <div class="card-body" style="margin-top: 40px; margin-bottom: 40px;">
                        
                        <div id="databaseGrid" style="font-size: 12px;"></div>

                        <script type="text/x-kendo-template" id="databaseKendoTemplate">
                            <div style="margin-top: 10px; width: 100%">

                                <div style="float: left; width: 50%">
                                    <div class="input-group" style="margin-bottom: 10px;">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" style="font-size: 12px;">Server</span>
                                        </div>
                                        <input id="serverId" class="form-control" style="font-size: 12px; width: 100%" />
                                    </div>
                                    <div class="input-group" style="margin-bottom: 10px;">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" style="font-size: 12px;">Port</span>
                                        </div>
                                        <input id="portId" class="form-control" style="font-size: 12px; width: 100%" />
                                    </div>
                                </div>
                                <div style="float: left; width: 50%">
                                    <div class="input-group" style="margin-bottom: 10px;">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" style="font-size: 12px;">Instance</span>
                                        </div>
                                        <input id="instanceId" class="form-control" style="font-size: 12px; width: 100%" />
                                    </div>
                                    <div class="input-group" style="margin-bottom: 10px;">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" style="font-size: 12px;">Database</span>
                                        </div>
                                        <input id="databaseId" class="form-control" style="font-size: 12px; width: 100%" />
                                    </div>
                                </div>

                                <div style="float: left; width: 50%">
                                    <div class="input-group" style="margin-bottom: 10px;">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" style="font-size: 12px;">UserName</span>
                                        </div>
                                        <input id="usernameId" class="form-control" style="font-size: 12px; width: 100%" />
                                    </div>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" style="font-size: 12px;">Schema</span>
                                        </div>
                                        <input id="schemaId" class="form-control" style="font-size: 12px; width: 100%" />
                                    </div>
                                </div>
                                <div style="float: left; width: 50%">
                                    <div class="input-group" style="margin-bottom: 10px;">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" style="font-size: 12px;">Password</span>
                                        </div>
                                        <input id="passwordId" class="form-control" style="font-size: 12px; width: 100%" />
                                    </div>

                                    <a href="\\#" class="btn btn-sm custHeaderBackground" onclick="return AddDatabase();" style="font-size: 12px; color: white; float: right; margin-right: 10px;">Add Database</a>
                                </div>
                            </div>
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/kendo")
    @Scripts.Render("~/bundles/databaseSettings")
    @Scripts.Render("~/bundles/syncAdminSettings")
}