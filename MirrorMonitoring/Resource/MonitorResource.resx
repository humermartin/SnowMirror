  <data name="DeltaAlert" xml:space="preserve">
    <value>&lt;meta http-equiv='Content-Type' content='text/html; charset=utf-8'&gt;
&lt;div id="header-img"&gt;
	&lt;img width="595" height="66" id="_x0000_i1025" alt="alertheader" src='https://vmsnwwp110.isp.local/MirrorWeb/content/images/SnowDbSyncAlert.jpg' border="0"&gt;
&lt;/div&gt;
&lt;br /&gt;
&lt;div id="intro" style="color: black; font-family: Verdana, sans-serif; font-size: 9pt;"&gt;
    &lt;span style="font-weight: bold"&gt;Hello SnowDbSync Admin/Support!&lt;/span&gt; 
	&lt;br /&gt;
	&lt;br /&gt;
	&lt;span&gt;This is an automatic alert warning from ServiceNOW database synchronization.&lt;/span&gt;
	&lt;br /&gt;
	&lt;br /&gt;
	&lt;div id="intro" style="color: black; font-family: Verdana, sans-serif; font-size: 9pt;"&gt;
		&lt;span&gt;The tool detected that the synchronization &lt;span style="font-weight: bold"&gt; {aSync.Name} &lt;/span&gt; did not start at the scheduled time.&lt;/span&gt;
		&lt;br /&gt;
		&lt;ul type="square" style="color: rgb(218, 41, 21);"&gt;
			&lt;li&gt;
				&lt;span style="font-weight: bold"&gt;Synchronization:&lt;/span&gt;
				&lt;span style="color: black; font-family: Verdana, sans-serif; font-size: 9pt;"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{aSync.Name}&lt;/span&gt;
			&lt;/li&gt;
            &lt;li&gt;
				&lt;span style="font-weight: bold"&gt;Type:&lt;/span&gt;
				&lt;span style="color: black; font-family: Verdana, sans-serif; font-size: 9pt;"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{aSync.SyncType.TypeName}&lt;/span&gt;
			&lt;/li&gt;	
            &lt;li&gt;
				&lt;span style="font-weight: bold"&gt;Instance:&lt;/span&gt;
				&lt;span style="color: black; font-family: Verdana, sans-serif; font-size: 9pt;"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{aSync.InstanzSettings.InstanzName}&lt;/span&gt;
			&lt;/li&gt;	
			&lt;li&gt;
				&lt;span style="font-weight: bold"&gt;Scheduled Starttime:&lt;/span&gt;
				&lt;span style="color: black; font-family: Verdana, sans-serif; font-size: 9pt;"&gt;{requestedNextStart}&lt;/span&gt;
			&lt;/li&gt;	
        &lt;/ul&gt;
		&lt;br /&gt;			   
        &lt;div id="intro" style="color: black; font-family: Verdana, sans-serif; font-size: 9pt;"&gt;
			&lt;span&gt;Last start date is longer than 2 period intervals(period in minutes:&lt;span style="font-weight: bold"&gt;{aSync.PeriodInterval}&lt;/span&gt;).&lt;/span&gt;
		&lt;/div&gt;
		&lt;br /&gt;
        &lt;div id="intro" style="color: rgb(218, 41, 21); font-family: Verdana, sans-serif; font-size: 9pt; font-weight: bold;"&gt;
            &lt;span&gt;Please check the reason and start them &lt;span&gt;&lt;a href="https://vmsnwwp110.isp.local/MirrorWeb/"&gt;manually&lt;/a&gt;&lt;/span&gt;.&lt;/span&gt;
        &lt;/div&gt;    
	&lt;/div&gt;
&lt;/div&gt;
&lt;br&gt;
&lt;br&gt;
&lt;span style="float:left; color: #293E40; font-size: 12px; font-family: Helvetica Neue, Helvetica, Arial, sans-serif;"&gt;email was triggered from SNOW DbSync&lt;/span&gt;</value>
  </data>
