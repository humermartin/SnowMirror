				&lt;span style="color: black; font-family: Verdana, sans-serif; font-size: 9pt;"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{aSync.SyncType.TypeName}&lt;/span&gt;
			&lt;/li&gt;	
            &lt;li&gt;
				&lt;span style="font-weight: bold"&gt;Instance:&lt;/span&gt;
				&lt;span style="color: black; font-family: Verdana, sans-serif; font-size: 9pt;"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{aSync.InstanzSettings.InstanzName}&lt;/span&gt;
			&lt;/li&gt;	
			&lt;li&gt;
				&lt;span style="font-weight: bold"&gt;Started:&lt;/span&gt;
				&lt;span style="color: black; font-family: Verdana, sans-serif; font-size: 9pt;"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{aSync.StartTime}&lt;/span&gt;
			&lt;/li&gt;	
		&lt;/ul&gt;
		&lt;br /&gt;			   
        &lt;br /&gt;
        &lt;div id="intro" style="color: rgb(218, 41, 21); font-family: Verdana, sans-serif; font-size: 9pt; font-weight: bold;"&gt;
            &lt;span&gt;Please check the reason and start them &lt;span&gt;&lt;a href="https://vmsnwwp110.isp.local/MirrorWeb/"&gt;manually&lt;/a&gt;&lt;/span&gt;.&lt;/span&gt;
        &lt;/div&gt;    
	&lt;/div&gt;
&lt;/div&gt;
&lt;br&gt;
&lt;br&gt;
&lt;span style="float:left; color: #293E40; font-size: 12px; font-family: Helvetica Neue, Helvetica, Arial, sans-serif;"&gt;email was triggered from SNOW DbSync&lt;/span&gt;</value>
